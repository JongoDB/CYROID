# .gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
.eggs/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
.npm
.pnpm-store/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
*.local

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Test
coverage/
htmlcov/
.coverage

# Build
build/
*.log
backend/venv_test/
frontend/test-results/
frontend/playwright-report/
.playwright-mcp/
.claude-playwright/
test-results/

# Certificates
certs/

# Production environment (contains secrets)
.env.prod

# ACME/Let's Encrypt data
acme/

# Traefik dynamic VNC routes (generated at runtime)
traefik/dynamic/range-*.yml

# Runtime data (local development cache)
data/

# VM disk images, installer ISOs, and Docker image tarballs.
# These are multi-GB binaries that must never enter git history: a single
# committed ISO left 4.5 GB of unreachable objects in .git that survived
# every routine `git gc` because the reflog kept pinning it.
*.iso
*.img
*.qcow2
*.qcow
*.vmdk
*.vdi
*.vhd
*.vhdx
*.raw

# Exported Docker image tarballs (blueprint export / offline bundles)
*.tar
*.tar.gz
*.tar.zst

# Git worktrees
.worktrees/
